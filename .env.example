# CloserArena AI — environment variables

# Anthropic (optional — fallback lines work without it)
ANTHROPIC_API_KEY=

# Stripe — use either Checkout API or a hosted Payment Link
# Option A: server Checkout Session
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Public site URL for redirect after checkout (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Option B: paste a Stripe Payment Link URL (used if API keys missing)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
