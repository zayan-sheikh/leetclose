# CloserArena AI — environment variables

# HeyGen Live Avatar (video prospect on /call) — server-only
LIVEAVATAR_API_KEY=

# Google Gemini — prospect chat (/api/chat)
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Stripe — Checkout or Payment Link
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Optional: local Fetch uAgents (fetch-bridge/run_all_agents.py) — defaults 8765–8767
# FETCH_BRIDGE_BASE_URL=http://127.0.0.1:8765
# FETCH_BRIDGE_STATS_URL=http://127.0.0.1:8766
# FETCH_BRIDGE_CHALLENGE_URL=http://127.0.0.1:8767
